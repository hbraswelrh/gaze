<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="gaze {{.Version}}">
<title>Gaze Analysis Report</title>
<style>
*,*::before,*::after{box-sizing:border-box}
body{margin:0;padding:24px;font-family:system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;color:#1a1a2e;background:#fafbfc}
h1{font-size:1.4em;margin:0 0 4px}
.version{color:#6b7280;font-size:.85em;margin:0 0 20px}
.summary{margin:0 0 24px;padding:12px 16px;background:#f0f4f8;border-radius:6px;font-size:.95em}
.empty{padding:32px 16px;text-align:center;color:#6b7280;font-size:1em}
details{margin:0 0 8px;border:1px solid #e2e8f0;border-radius:6px;background:#fff}
summary{cursor:pointer;padding:10px 14px;font-weight:600;font-size:.95em;list-style:none;user-select:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"\25B6";display:inline-block;margin-right:8px;font-size:.7em;transition:transform .15s}
details[open]>summary::before{transform:rotate(90deg)}
.fn-location{display:block;font-weight:400;font-size:.8em;color:#6b7280;margin-top:2px}
.fn-sig{display:block;font-weight:400;font-size:.82em;color:#4b5563;font-family:ui-monospace,monospace;margin-top:2px}
.effects{padding:0 14px 14px}
table{width:100%;border-collapse:collapse;font-size:.88em;margin-top:8px}
th{text-align:left;padding:6px 10px;background:#f8fafc;border-bottom:2px solid #e2e8f0;font-size:.8em;text-transform:uppercase;letter-spacing:.04em;color:#64748b}
td{padding:6px 10px;border-bottom:1px solid #f1f5f9;vertical-align:top}
tr:last-child td{border-bottom:none}
.tier{font-weight:600;white-space:nowrap}
.tier-p0{color:#dc2626}
.tier-p1{color:#ea580c}
.tier-p2{color:#ca8a04}
.tier-p3{color:#2563eb}
.tier-p4{color:#6b7280}
.type{font-family:ui-monospace,monospace;font-size:.92em;white-space:nowrap}
.classification{font-size:.85em;color:#4b5563}
.detail{font-size:.82em;color:#6b7280;font-family:ui-monospace,monospace;word-break:break-all}
.no-effects{padding:12px 0;color:#6b7280;font-style:italic}
</style>
</head>
<body>
<h1>Gaze Analysis Report</h1>
<p class="version">gaze {{.Version}}</p>
{{- if eq (len .Functions) 0}}
<div class="empty">No functions were analyzed.</div>
{{- else}}
<div class="summary">{{len .Functions}} function(s) analyzed, {{.TotalEffects}} side effect(s) detected</div>
{{- range .Functions}}
<details>
<summary>{{.Name}}<span class="fn-location">{{.Location}}</span><span class="fn-sig">{{.Signature}}</span></summary>
<div class="effects">
{{- if eq .EffectCount 0}}
<p class="no-effects">No side effects detected.</p>
{{- else}}
<table>
<thead><tr><th>Tier</th><th>Type</th><th>Description</th><th>Location</th>{{- if $.HasClassification}}<th>Classification</th>{{end}}{{- if $.HasDetail}}<th>Detail</th>{{end}}</tr></thead>
<tbody>
{{- range .Effects}}
<tr>
<td class="tier tier-{{.TierClass}}">{{.Tier}}</td>
<td class="type">{{.Type}}</td>
<td>{{.Description}}</td>
<td>{{.Location}}</td>
{{- if $.HasClassification}}<td class="classification">{{.Classification}}</td>{{end}}
{{- if $.HasDetail}}<td class="detail">{{.Detail}}</td>{{end}}
</tr>
{{- end}}
</tbody>
</table>
{{- end}}
</div>
</details>
{{- end}}
{{- end}}
</body>
</html>
